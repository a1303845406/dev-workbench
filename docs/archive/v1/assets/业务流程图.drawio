        <mxCell id="f49" value="人工标记执行状态（待投喂/已投喂/已完成/失败）+ 记录效果反馈&#10;→ FR-07 看板 / 提示词版本迭代" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10" vertex="1" parent="1">
