.env*
!.env.example
workspace/*.sqlite3
workspace/projects/*
workspace/logs/*
workspace/planning-*.png
backups/*
!backups/.gitkeep
!workspace/.gitkeep
logs/
*.lock

# --- IDE / OS ---
.idea/
.vscode/
# Machine-local agent MCP configuration (absolute executable paths)
.zcode/
.DS_Store
Thumbs.db

# --- pytest temp / stray tmp ---
pytest-of-*/
.pytest-basetemp/
tmp*.pem
tmp*

pip-unpack-*/
pip-install-*/

# --- e2e scratch ---
devwb-e2e-*/

# E2E 测试运行时残留
configs/templates/e2e*

# 配置滚动备份（运行时产物）
configs/*.bak
configs/*.bak2
configs/*.bak3
