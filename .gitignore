# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
/build/
/dist/

# --- Node / frontend ---
node_modules/
apps/web/dist/
apps/web/.tmp/
apps/web/.npm-cache/
*.local

# --- Runtime data (product data roots) ---
workspace/*
